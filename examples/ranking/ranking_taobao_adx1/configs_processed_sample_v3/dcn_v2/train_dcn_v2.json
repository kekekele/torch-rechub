    "regularization": {
        "embedding_l1": 0.0,
        "embedding_l2": 0.0,
        "dense_l1": 0.0,
        "dense_l2": 0.0
    },
    "dcn_v2": {
        "n_cross_layers": 3,
        "model_structure": "parallel",
        "use_low_rank_mixture": true,
        "low_rank": 16,
        "num_experts": 4,
        "mlp_params": {
            "dims": [
                256,
                128
            ],
            "dropout": 0.25,
            "activation": "relu"
        }
    }
