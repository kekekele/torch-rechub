{
    "data_dir": "projects/ranking_taobao_ad/outputs/onetrans/data",
    "save_dir": "projects/ranking_taobao_ad/outputs/onetrans/checkpoints",
    "device": "cuda:0",
    "seed": 2026,
    "num_workers": 0,
    "training": {
        "epoch": 50,
        "batch_size": 512,
        "learning_rate": 0.0005,
        "weight_decay": 0.0005,
        "earlystop_patience": 4,
        "train_split": "train",
        "valid_split": "valid"
    },
    "regularization": {
        "embedding_l1": 0.0,
        "embedding_l2": 0.0,
        "dense_l1": 0.0,
        "dense_l2": 0.0
    },
    "onetrans": {
        "s_tokenizer": {
            "use_sep_token": false,
            "sequences": [
                {
                    "name": "history",
                    "features": [
                        {
                            "name": "seq.iid",
                            "dim": 24
                        },
                        {
                            "name": "item.cate_id",
                            "dim": 12
                        },
                        {
                            "name": "item.brand",
                            "dim": 8
                        }
                    ]
                }
            ]
        },
        "ns_tokenizer": {
            "type": "group_wise",
            "groups": [
                {
                    "name": "user",
                    "num_tokens": 2,
                    "features": [
                        {
                            "name": "user.cms_segid",
                            "dim": 8
                        },
                        {
                            "name": "user.cms_group_id",
                            "dim": 8
                        },
                        {
                            "name": "user.final_gender_code",
                            "dim": 4
                        },
                        {
                            "name": "user.age_level",
                            "dim": 4
                        },
                        {
                            "name": "user.pvalue_level",
                            "dim": 4
                        },
                        {
                            "name": "user.shopping_level",
                            "dim": 4
                        },
                        {
                            "name": "user.occupation",
                            "dim": 4
                        },
                        {
                            "name": "user.new_user_class_level",
                            "dim": 4
                        }
                    ]
                },
                {
                    "name": "target",
                    "num_tokens": 2,
                    "features": [
                        {
                            "name": "item.iid",
                            "dim": 24
                        },
                        {
                            "name": "item.cate_id",
                            "dim": 12
                        },
                        {
                            "name": "item.brand",
                            "dim": 8
                        },
                        {
                            "name": "item.customer",
                            "dim": 8
                        },
                        {
                            "name": "item.campaign_id",
                            "dim": 8
                        }
                    ]
                },
                {
                    "name": "context",
                    "num_tokens": 2,
                    "features": [
                        {
                            "name": "seq.pid",
                            "dim": 8
                        },
                        {
                            "name": "seq.timestamp",
                            "dim": 4
                        }
                    ]
                }
            ]
        },
        "d_model": 48,
        "num_heads": 4,
        "ffn_hidden": 96,
        "blocks_per_stage": 1,
        "num_pyramid_layers": 2,
        "pyramid_align": 16,
        "mask_type": "causal",
        "use_checkpoint": false,
        "head_dropout": 0.3
    }
}